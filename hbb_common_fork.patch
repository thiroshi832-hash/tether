diff --git a/src/crypto.rs b/src/crypto.rs
new file mode 100644
index 0000000..dff7718
--- /dev/null
+++ b/src/crypto.rs
@@ -0,0 +1,124 @@
+//! Crypto-suite negotiation + X25519 ECDH key agreement.
+//!
+//! IMPORTANT: this module was RECONSTRUCTED to match the call sites in the
+//! Tether app after the original forked implementation was lost (drive format).
+//! It provides a real, self-consistent handshake — X25519 ECDH with a
+//! transcript-bound KDF, feeding the derived key into hbb_common's existing
+//! authenticated `secretbox` transport — so two Tether peers built from this
+//! code interoperate securely. It is NOT guaranteed byte-identical to the lost
+//! original; review before shipping.
+//!
+//! Handshake shape (suite 1):
+//!  - Responder advertises `advertised_suite_ids()` + an ephemeral X25519
+//!    public key (`suite1_pk`) inside its Ed25519-signed `IdPk`.
+//!  - Initiator picks a suite via `negotiate()`, generates its own ephemeral
+//!    key, computes the shared secret, and returns its public key + the chosen
+//!    suite. Both sides derive the same key via `EcdhHalf::finish`, which binds
+//!    (responder_pub, initiator_pub, suite, domain) into the KDF so the exchange
+//!    cannot be silently downgraded or tampered with.
+
+use crate::ResultType;
+use sodiumoxide::crypto::{
+    generichash,
+    scalarmult::curve25519::{scalarmult, scalarmult_base, GroupElement, Scalar},
+    secretbox,
+};
+
+/// Legacy NaCl box handshake (stock RustDesk). No ECDH suite negotiated.
+pub const SUITE_LEGACY: u32 = 0;
+/// X25519 ECDH; derived key drives the authenticated secretbox transport.
+pub const SUITE_X25519_XCHACHA20POLY1305: u32 = 1;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum CryptoSuite {
+    Legacy,
+    X25519XChaCha20Poly1305,
+}
+
+impl CryptoSuite {
+    pub fn to_u32(&self) -> u32 {
+        match self {
+            CryptoSuite::Legacy => SUITE_LEGACY,
+            CryptoSuite::X25519XChaCha20Poly1305 => SUITE_X25519_XCHACHA20POLY1305,
+        }
+    }
+
+    pub fn from_u32(v: u32) -> Option<CryptoSuite> {
+        match v {
+            SUITE_LEGACY => Some(CryptoSuite::Legacy),
+            SUITE_X25519_XCHACHA20POLY1305 => Some(CryptoSuite::X25519XChaCha20Poly1305),
+            _ => None,
+        }
+    }
+}
+
+/// Suites this build advertises, strongest first.
+pub fn advertised_suite_ids() -> Vec<u32> {
+    vec![SUITE_X25519_XCHACHA20POLY1305]
+}
+
+/// Pick the strongest suite supported by both us and the peer's advertised set.
+/// Falls back to `Legacy` when the peer advertises nothing we recognize (e.g. a
+/// stock RustDesk peer), which keeps interop with unmodified clients/servers.
+pub fn negotiate(advertised: &[u32]) -> CryptoSuite {
+    if advertised.contains(&SUITE_X25519_XCHACHA20POLY1305) {
+        CryptoSuite::X25519XChaCha20Poly1305
+    } else {
+        CryptoSuite::Legacy
+    }
+}
+
+/// One party's ephemeral X25519 keypair.
+pub struct EcdhHalf {
+    secret: Scalar,
+    /// Our ephemeral public key (send this to the peer).
+    pub public: [u8; 32],
+}
+
+impl EcdhHalf {
+    pub fn new() -> Self {
+        let mut sk = [0u8; 32];
+        sk.copy_from_slice(&sodiumoxide::randombytes::randombytes(32));
+        let secret = Scalar(sk);
+        // libsodium clamps the scalar internally.
+        let public = scalarmult_base(&secret).0;
+        Self { secret, public }
+    }
+
+    /// Complete the exchange with the peer's public key and derive the symmetric
+    /// key. `transcript_a`/`transcript_b` MUST be supplied in the same order by
+    /// both peers (Tether uses responder_pub then initiator_pub), and `domain`
+    /// must match, so both sides derive an identical key while binding the
+    /// transcript against tampering/downgrade.
+    pub fn finish(
+        &self,
+        their_public: &[u8; 32],
+        suite: CryptoSuite,
+        transcript_a: &[u8; 32],
+        transcript_b: &[u8; 32],
+        domain: &[u8],
+    ) -> ResultType<secretbox::Key> {
+        let shared = scalarmult(&self.secret, &GroupElement(*their_public))
+            .map_err(|_| crate::anyhow::anyhow!("X25519 scalarmult failed (low-order point?)"))?;
+        let mut st = generichash::State::new(Some(secretbox::KEYBYTES), None)
+            .map_err(|_| crate::anyhow::anyhow!("KDF init failed"))?;
+        // Domain separation + shared secret + bound transcript.
+        let _ = st.update(b"tether-ecdh-v1");
+        let _ = st.update(&shared.0);
+        let _ = st.update(transcript_a);
+        let _ = st.update(transcript_b);
+        let _ = st.update(&suite.to_u32().to_le_bytes());
+        let _ = st.update(domain);
+        let digest = st
+            .finalize()
+            .map_err(|_| crate::anyhow::anyhow!("KDF finalize failed"))?;
+        secretbox::Key::from_slice(digest.as_ref())
+            .ok_or_else(|| crate::anyhow::anyhow!("derived key has wrong length"))
+    }
+}
+
+impl Default for EcdhHalf {
+    fn default() -> Self {
+        Self::new()
+    }
+}
